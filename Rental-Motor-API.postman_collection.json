    {
      "name": "Tambah Motor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Motor berhasil dibuat\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\nconst motor = response.data ?? response;\r\n\r\nif (motor.id) {\r\n    pm.environment.set(\"motor_id\", motor.id);\r\n}\r\n\r\npm.test(\"ID motor tersedia\", function () {\r\n    pm.expect(motor.id).to.exist;\r\n});"
            ]
          }
        }
      ],
